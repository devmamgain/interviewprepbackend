# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# --- Database ---
MONGODB_URI=
# --- Auth ---
# Any long random string. Used to sign session/JWT tokens.
SESSION_SECRET=gdfgdfgdfjfkdpgkfgkhjkgfjhgnmvcvnv
SESSION_TTL_HOURS=24

# --- LLM (Google Gemini free tier) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY= 
GEMINI_MODEL=gemini-3.5-flash-lite
# Requests-per-minute the free tier allows for the chosen model. Used to pace
# our own client-side throttle so we back off before Google does.
GEMINI_RPM_LIMIT=15

# --- Crawler ---
CRAWLER_USER_AGENT=InterviewPrepKitBot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES_PER_SITE=8
CRAWLER_REQUEST_TIMEOUT_MS=8000
CRAWLER_MIN_DELAY_MS=500
# Set to "true" to allow fetching localhost/private IPs (needed for the
# `npm run evaluate` grading harness, which may serve fixtures locally).
ALLOW_PRIVATE_HOSTS=false

# --- Public discussion search ---
# Optional. If set, used instead of the built-in DuckDuckGo HTML scraper.
# Bing Web Search / SerpAPI / etc. all work if you map the response shape in
# backend/src/services/research/searchProvider.ts
SEARCH_PROVIDER_API_KEY=
